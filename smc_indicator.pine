//@version=5
indicator("SMC Indicator - Complete", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════
// INPUT SETTINGS
// ═══════════════════════════════════════════════════════════════════════

// Order Block Settings
showOB = input.bool(true, "Show Order Blocks", group="Order Blocks")
obLength = input.int(5, "Order Block Length", minval=1, group="Order Blocks")
bullishOBColor = input.color(color.new(color.green, 80), "Bullish OB Color", group="Order Blocks")
bearishOBColor = input.color(color.new(color.red, 80), "Bearish OB Color", group="Order Blocks")

// Fair Value Gap Settings
showFVG = input.bool(true, "Show Fair Value Gaps", group="Fair Value Gaps")
fvgBullColor = input.color(color.new(color.blue, 85), "Bullish FVG Color", group="Fair Value Gaps")
fvgBearColor = input.color(color.new(color.orange, 85), "Bearish FVG Color", group="Fair Value Gaps")

// Liquidity Settings
showLiquidity = input.bool(true, "Show Liquidity Levels", group="Liquidity")
liquidityLength = input.int(20, "Liquidity Lookback", minval=5, group="Liquidity")
liquidityColor = input.color(color.purple, "Liquidity Color", group="Liquidity")

// High/Low Settings
showHighLow = input.bool(true, "Show Higher Highs/Lower Lows", group="Structure")
swingLength = input.int(5, "Swing Length", minval=2, group="Structure")

// BOS & ChoCh Settings
showBOS = input.bool(true, "Show Break of Structure", group="Structure")
showChoch = input.bool(true, "Show Change of Character", group="Structure")
bosColor = input.color(color.green, "BOS Color", group="Structure")
chochColor = input.color(color.red, "ChoCh Color", group="Structure")

// Bias Settings
showBias = input.bool(true, "Show Market Bias", group="Bias")
biasLength = input.int(50, "Bias Period", minval=10, group="Bias")

// ═══════════════════════════════════════════════════════════════════════
// FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════

// Swing High/Low Detection
isSwingHigh(len) =>
    highestBar = ta.highestbars(high, len * 2 + 1)
    highestBar == -len

isSwingLow(len) =>
    lowestBar = ta.lowestbars(low, len * 2 + 1)
    lowestBar == -len

// ═══════════════════════════════════════════════════════════════════════
// ORDER BLOCK DETECTION
// ═══════════════════════════════════════════════════════════════════════

var box[] bullishOBs = array.new_box()
var box[] bearishOBs = array.new_box()

// Bullish Order Block: Last down candle before strong up move
isBullishOB = close[1] < open[1] and close > open and (high - low) > (high[1] - low[1]) * 1.5
if showOB and isBullishOB
    ob = box.new(bar_index[1], high[1], bar_index + obLength, low[1],
         border_color=color.new(color.green, 50),
         bgcolor=bullishOBColor,
         border_width=1,
         extend=extend.none)
    array.push(bullishOBs, ob)
    if array.size(bullishOBs) > 50
        box.delete(array.shift(bullishOBs))

// Bearish Order Block: Last up candle before strong down move
isBearishOB = close[1] > open[1] and close < open and (high - low) > (high[1] - low[1]) * 1.5
if showOB and isBearishOB
    ob = box.new(bar_index[1], high[1], bar_index + obLength, low[1],
         border_color=color.new(color.red, 50),
         bgcolor=bearishOBColor,
         border_width=1,
         extend=extend.none)
    array.push(bearishOBs, ob)
    if array.size(bearishOBs) > 50
        box.delete(array.shift(bearishOBs))

// ═══════════════════════════════════════════════════════════════════════
// FAIR VALUE GAP (FVG) DETECTION
// ═══════════════════════════════════════════════════════════════════════

var box[] bullishFVGs = array.new_box()
var box[] bearishFVGs = array.new_box()

// Bullish FVG: Gap between high[2] and low[0]
bullishFVG = low > high[2]
if showFVG and bullishFVG
    fvg = box.new(bar_index[2], low, bar_index + 20, high[2],
         border_color=color.new(color.blue, 50),
         bgcolor=fvgBullColor,
         border_width=1,
         extend=extend.none)
    array.push(bullishFVGs, fvg)
    if array.size(bullishFVGs) > 30
        box.delete(array.shift(bullishFVGs))

// Bearish FVG: Gap between low[2] and high[0]
bearishFVG = high < low[2]
if showFVG and bearishFVG
    fvg = box.new(bar_index[2], low[2], bar_index + 20, high,
         border_color=color.new(color.orange, 50),
         bgcolor=fvgBearColor,
         border_width=1,
         extend=extend.none)
    array.push(bearishFVGs, fvg)
    if array.size(bearishFVGs) > 30
        box.delete(array.shift(bearishFVGs))

// ═══════════════════════════════════════════════════════════════════════
// LIQUIDITY ZONES
// ═══════════════════════════════════════════════════════════════════════

var line[] liquidityLines = array.new_line()
var label[] liquidityLabels = array.new_label()

// Detect liquidity at swing highs and lows
swingHigh = isSwingHigh(swingLength)
swingLow = isSwingLow(swingLength)

if showLiquidity and swingHigh
    ln = line.new(bar_index[swingLength], high[swingLength], bar_index, high[swingLength],
         color=liquidityColor,
         width=2,
         style=line.style_dashed,
         extend=extend.right)
    lbl = label.new(bar_index[swingLength], high[swingLength], "LIQUIDITY",
         style=label.style_label_down,
         color=color.new(liquidityColor, 70),
         textcolor=color.white,
         size=size.tiny)
    array.push(liquidityLines, ln)
    array.push(liquidityLabels, lbl)
    if array.size(liquidityLines) > 20
        line.delete(array.shift(liquidityLines))
        label.delete(array.shift(liquidityLabels))

if showLiquidity and swingLow
    ln = line.new(bar_index[swingLength], low[swingLength], bar_index, low[swingLength],
         color=liquidityColor,
         width=2,
         style=line.style_dashed,
         extend=extend.right)
    lbl = label.new(bar_index[swingLength], low[swingLength], "LIQUIDITY",
         style=label.style_label_up,
         color=color.new(liquidityColor, 70),
         textcolor=color.white,
         size=size.tiny)
    array.push(liquidityLines, ln)
    array.push(liquidityLabels, lbl)
    if array.size(liquidityLines) > 20
        line.delete(array.shift(liquidityLines))
        label.delete(array.shift(liquidityLabels))

// ═══════════════════════════════════════════════════════════════════════
// HIGH/LOW STRUCTURE
// ═══════════════════════════════════════════════════════════════════════

var label[] structureLabels = array.new_label()

if showHighLow and swingHigh
    isHigherHigh = high[swingLength] > ta.highest(high[swingLength + 1], liquidityLength)
    if isHigherHigh
        lbl = label.new(bar_index[swingLength], high[swingLength], "HH",
             style=label.style_label_down,
             color=color.new(color.green, 30),
             textcolor=color.white,
             size=size.small)
        array.push(structureLabels, lbl)
    else
        lbl = label.new(bar_index[swingLength], high[swingLength], "LH",
             style=label.style_label_down,
             color=color.new(color.red, 30),
             textcolor=color.white,
             size=size.small)
        array.push(structureLabels, lbl)
    if array.size(structureLabels) > 30
        label.delete(array.shift(structureLabels))

if showHighLow and swingLow
    isHigherLow = low[swingLength] > ta.lowest(low[swingLength + 1], liquidityLength)
    if isHigherLow
        lbl = label.new(bar_index[swingLength], low[swingLength], "HL",
             style=label.style_label_up,
             color=color.new(color.green, 30),
             textcolor=color.white,
             size=size.small)
        array.push(structureLabels, lbl)
    else
        lbl = label.new(bar_index[swingLength], low[swingLength], "LL",
             style=label.style_label_up,
             color=color.new(color.red, 30),
             textcolor=color.white,
             size=size.small)
        array.push(structureLabels, lbl)
    if array.size(structureLabels) > 30
        label.delete(array.shift(structureLabels))

// ═══════════════════════════════════════════════════════════════════════
// BREAK OF STRUCTURE (BOS) & CHANGE OF CHARACTER (ChoCh)
// ═══════════════════════════════════════════════════════════════════════

var float lastSwingHigh = na
var float lastSwingLow = na
var label[] bosLabels = array.new_label()
var label[] chochLabels = array.new_label()

// Update swing points
if swingHigh
    lastSwingHigh := high[swingLength]

if swingLow
    lastSwingLow := low[swingLength]

// BOS Detection (continuation)
if showBOS and not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
    lbl = label.new(bar_index, high, "BOS ↑",
         style=label.style_label_up,
         color=color.new(bosColor, 20),
         textcolor=color.white,
         size=size.normal)
    array.push(bosLabels, lbl)
    if array.size(bosLabels) > 20
        label.delete(array.shift(bosLabels))

if showBOS and not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
    lbl = label.new(bar_index, low, "BOS ↓",
         style=label.style_label_down,
         color=color.new(bosColor, 20),
         textcolor=color.white,
         size=size.normal)
    array.push(bosLabels, lbl)
    if array.size(bosLabels) > 20
        label.delete(array.shift(bosLabels))

// ChoCh Detection (reversal)
var int trend = 0  // 1 = bullish, -1 = bearish

if not na(lastSwingHigh) and close > lastSwingHigh
    if trend == -1 and showChoch
        lbl = label.new(bar_index, high, "ChoCh ↑",
             style=label.style_label_up,
             color=color.new(chochColor, 20),
             textcolor=color.white,
             size=size.normal)
        array.push(chochLabels, lbl)
        if array.size(chochLabels) > 20
            label.delete(array.shift(chochLabels))
    trend := 1

if not na(lastSwingLow) and close < lastSwingLow
    if trend == 1 and showChoch
        lbl = label.new(bar_index, low, "ChoCh ↓",
             style=label.style_label_down,
             color=color.new(chochColor, 20),
             textcolor=color.white,
             size=size.normal)
        array.push(chochLabels, lbl)
        if array.size(chochLabels) > 20
            label.delete(array.shift(chochLabels))
    trend := -1

// ═══════════════════════════════════════════════════════════════════════
// MARKET BIAS
// ═══════════════════════════════════════════════════════════════════════

// Calculate bias based on market structure
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

bias = ema20 > ema50 and ema50 > ema200 ? 1 :
       ema20 < ema50 and ema50 < ema200 ? -1 : 0

biasColor = bias == 1 ? color.new(color.green, 90) :
            bias == -1 ? color.new(color.red, 90) :
            color.new(color.gray, 90)

bgcolor(showBias ? biasColor : na, title="Market Bias Background")

// Display bias label
var label biasLabel = na
if showBias and barstate.islast
    label.delete(biasLabel)
    biasText = bias == 1 ? "BULLISH BIAS" :
               bias == -1 ? "BEARISH BIAS" :
               "NEUTRAL"
    biasLabelColor = bias == 1 ? color.green :
                     bias == -1 ? color.red :
                     color.gray
    biasLabel := label.new(bar_index, high, biasText,
         style=label.style_label_down,
         color=color.new(biasLabelColor, 0),
         textcolor=color.white,
         size=size.large,
         yloc=yloc.abovebar)

// ═══════════════════════════════════════════════════════════════════════
// PLOTS & VISUALS
// ═══════════════════════════════════════════════════════════════════════

// Plot EMAs for bias reference
plot(showBias ? ema20 : na, "EMA 20", color=color.new(color.blue, 50), linewidth=1)
plot(showBias ? ema50 : na, "EMA 50", color=color.new(color.orange, 50), linewidth=1)
plot(showBias ? ema200 : na, "EMA 200", color=color.new(color.red, 50), linewidth=2)

// ═══════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════

alertcondition(isBullishOB, title="Bullish Order Block", message="Bullish Order Block Detected")
alertcondition(isBearishOB, title="Bearish Order Block", message="Bearish Order Block Detected")
alertcondition(bullishFVG, title="Bullish FVG", message="Bullish Fair Value Gap Detected")
alertcondition(bearishFVG, title="Bearish FVG", message="Bearish Fair Value Gap Detected")
